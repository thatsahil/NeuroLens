# NeuroLens Federated Learning Research Backend Configuration
PROJECT_NAME="NeuroLens Federated Research Dashboard"
API_V1_STR="/api/v1"

# Security (Change to a strong random key in production)
SECRET_KEY="neurolens_dev_secret_key_change_in_production_min_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MongoDB Configuration
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="neurolens_federated_db"

# Federated Artifact Storage & Checkpoints
# Path to directory containing global_models/ and hospital_outputs/
NEUROLENS_ARTIFACT_ROOT="artifacts"
ACTIVE_MODEL_PATH="artifacts/global_models/global_model_round_001.pth"

# Optional Backend AI Research Assistant (Set your key here; NEVER expose to frontend)
GEMINI_API_KEY=""

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
